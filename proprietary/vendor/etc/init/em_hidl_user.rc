service emhidl_user /vendor/bin/em_hidl
    # A15: 同 dmc_core.rc —— vendor.mediatek.hardware.engineermode 的 .so 为原厂预编译 blob，
    # 树内无 hidl_interface 源码，host_init_verifier 已知接口集不含它 → 校验失败。
    # 本服务 disabled+oneshot 由外部显式 start，interface 行仅为懒启动注册，注释不影响显式启动。
    # interface vendor.mediatek.hardware.engineermode@1.0::IEmd EmHidlServer
    # interface vendor.mediatek.hardware.engineermode@1.1::IEmd EmHidlServer
    # interface vendor.mediatek.hardware.engineermode@1.2::IEmd EmHidlServer
    # interface vendor.mediatek.hardware.engineermode@1.3::IEmd EmHidlServer
    class hal
    oneshot
    disabled
    user system
    group bluetooth radio gps system nfc

# cannon: 本服务是 disabled，全树原本没有任何 trigger 显式 start 它，
# 导致 vendor.mediatek.hardware.engineermode@1.x::IEmd 永不注册；
# 走 EmUtils.getEmHidlService() 的 EM 菜单会在 onCreate 阻塞 5 s 后 ANR。
on property:sys.boot_completed=1
    start emhidl_user
